@model PaginatedList<Enrollment>

@{
    ViewData["Title"] = "Зачисления";
}

<div class="gh-page-header">
    <div class="gh-title">
        <h1>Зачисления</h1>
        <span class="gh-counter">@Model.Count()</span>
    </div>
    <a asp-action="Create" class="gh-btn gh-btn-primary">Добавить зачисление</a>
</div>

<div class="table-container">
    <div class="gh-table-box">
        <table class="gh-table">
            <thead>
                <tr>
                    <th>Студент</th>
                    <th>Курс</th>
                    <th>Оценка</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="gh-empty">Зачисления не найдены</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="gh-strong">@item.Student?.LastName @item.Student?.FirstName</td>
                        <td>@item.Course?.Title</td>
                        <td class="gh-mono">@(item.Grade?.ToString() ?? "—")</td>
                        <td class="gh-actions">
                            <a asp-action="Edit" asp-route-id="@item.EnrollmentID">Изменить</a> ·
                            <a asp-action="Details" asp-route-id="@item.EnrollmentID">Подробнее</a> ·
                            <a asp-action="Delete" asp-route-id="@item.EnrollmentID" class="gh-danger">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />
