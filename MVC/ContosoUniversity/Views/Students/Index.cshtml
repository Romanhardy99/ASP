@model IEnumerable<ContosoUniversity.Models.Student>

@{
    ViewData["Title"] = "Студенты";
}

<div class="gh-page-header">
    <div class="gh-title">
        <h1>Студенты</h1>
        <span class="gh-counter">@Model.Count()</span>
    </div>
    <a asp-action="Create" class="gh-btn gh-btn-primary">Добавить студента</a>
</div>

<form asp-action="Index" method="get" class="gh-search">
    @* <input type="search" name="searchString" value="@ViewData["CurrentFilter"]"
           placeholder="Поиск по фамилии…" aria-label="Поиск по фамилии" /> *@
           <label>
               Поиск по имени:
               <input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"/>
                <input type="submit" value="Поиск" class="gh-btn"/>
        <a asp-action="Index" class="gh-btn">Сбросить</a>
            </label>
    @* <button type="submit" class="gh-btn">Найти</button> *@
</form>

<div class="gh-table-box">
    <table class="gh-table">
        <thead>
            <tr>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">
                        @Html.DisplayNameFor(model => model.LastName)
                    </a>
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FirstName)
                </th>
                <th>
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]">
                        @Html.DisplayNameFor(model => model.EnrollmentDate)
                    </a>
                </th>
                <th></th>
                @* <th>Фамилия</th>
                <th>Имя</th>
                <th>Дата зачисления</th>
                <th></th> *@
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="4" class="gh-empty">Студенты не найдены</td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="gh-strong">@item.LastName</td>
                    <td>@item.FirstName</td>
                    <td class="gh-mono">@item.EnrollmentDate.ToString("dd.MM.yyyy")</td>
                    <td class="gh-actions">
                        <a asp-action="Edit" asp-route-id="@item.ID">Изменить</a> ·
                        <a asp-action="Details" asp-route-id="@item.ID">Подробнее</a> ·
                        <a asp-action="Delete" asp-route-id="@item.ID" class="gh-danger">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
