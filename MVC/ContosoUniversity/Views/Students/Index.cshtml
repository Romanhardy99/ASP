@* @model IEnumerable<ContosoUniversity.Models.Student> *@
@model PaginatedList<Student>

@{
    ViewData["Title"] = "Студенты";
}

<div class="gh-page-header">
    <div class="gh-title">
        <h1>Студенты</h1>
        <span class="gh-counter">@Model.Count()</span>
    </div>
    <a asp-action="Create" class="gh-btn gh-btn-primary">Добавить студента</a>
</div>

@{
    int size = (int)ViewData["ItemsPerPage"]!;
}

<form asp-action="Index" method="get" class="gh-search">
    <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />

    <input type="search" name="searchString" value="@ViewData["CurrentFilter"]"
           placeholder="Поиск по имени или фамилии…"
           aria-label="Поиск по имени или фамилии" />

    <button type="submit" class="gh-btn">Найти</button>
    <a asp-action="Index" asp-route-itemsPerPage="@size" class="gh-btn">Сбросить</a>

    <label class="gh-per-page">
        Строк:
        <select name="itemsPerPage" class="gh-select" onchange="this.form.submit()">
            <option value="3" selected="@(size == 3)">3</option>
            <option value="5" selected="@(size == 5)">5</option>
            <option value="10" selected="@(size == 10)">10</option>
        </select>
    </label>
</form>

<div class="table-container" style="--rows: @size">
    <div class="gh-table-box">
        <table class="gh-table">
            <thead>
                <tr>
                    <th>
                        <a asp-action="Index"
                           asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
                           asp-route-sortOrder="@ViewData["NameSortParam"]"
                           asp-route-currentFilter="@ViewData["CurrentFilter"]">
                            Last name
                            @* @Html.DisplayNameFor(model => model.LastName) *@
                        </a>
                    </th>
                    <th>
                        First name
                        @* @Html.DisplayNameFor(model => model.FirstName) *@
                    </th>
                    <th>
                        <a asp-action="Index"
                           asp-route-itemsPerPage="@ViewData["ItemsPerPage"]"
                           asp-route-sortOrder="@ViewData["DateSortParam"]"
                           asp-route-currentFilter="@ViewData["CurrentFilter"]">
                            Enrollment date
                            @* @Html.DisplayNameFor(model => model.EnrollmentDate) *@
                        </a>
                    </th>
                    <th></th>
                    @* <th>Фамилия</th>
                    <th>Имя</th>
                    <th>Дата зачисления</th>
                    <th></th> *@
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="gh-empty">Студенты не найдены</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="gh-strong">@item.LastName</td>
                        <td>@item.FirstName</td>
                        <td class="gh-mono">@item.EnrollmentDate.ToString("dd.MM.yyyy")</td>
                        <td class="gh-actions">
                            <a asp-action="Edit" asp-route-id="@item.ID">Изменить</a> ·
                            <a asp-action="Details" asp-route-id="@item.ID">Подробнее</a> ·
                            <a asp-action="Delete" asp-route-id="@item.ID" class="gh-danger">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />