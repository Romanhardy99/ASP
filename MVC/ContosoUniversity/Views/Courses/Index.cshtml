@model IEnumerable<ContosoUniversity.Models.Course>

@{
    ViewData["Title"] = "Курсы";
}


<div class="gh-page-header">
    <div class="gh-title">
        <h1>Курсы</h1>
        <span class="gh-counter">@Model.Count()</span>
    </div>
    <a asp-action="Create" class="gh-btn gh-btn-primary">Добавить курс</a>
</div>


<div class="table-container">
    <div class="gh-table-box">
        <table class="gh-table">
            <thead>
                <tr>
                    <th>Номер</th>
                    <th>Название</th>
                    <th>Кредиты </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="gh-empty">Курсы не найдены</td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>

                        <td class="gh-mono">@item.CourseID</td>
                        <td class="gh-strong">@item.Title</td>
                        <td>@item.Credits</td>
                        <td class="gh-actions">
                            <a asp-action="Edit" asp-route-id="@item.CourseID">Изменить</a> ·
                            <a asp-action="Details" asp-route-id="@item.CourseID">Подробнее</a> ·
                            <a asp-action="Delete" asp-route-id="@item.CourseID" class="gh-danger">Удалить</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_Pagination" model="Model" />