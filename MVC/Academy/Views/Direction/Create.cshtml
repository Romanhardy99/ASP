@model Academy.Models.Direction

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Direction</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="DirectionName" class="control-label"></label>
                <input asp-for="DirectionName" class="form-control" />
                <span asp-validation-for="DirectionName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Groups" class="control-label"></label>
                <input asp-for="Groups" class="form-control" />
                <span asp-validation-for="Groups" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Disciplines" class="control-label"></label>
                <input asp-for="Disciplines" class="form-control" />
                <span asp-validation-for="Disciplines" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
