@page "/movies"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Movies.Models
@implements IAsyncDisposable
@inject IDbContextFactory<MoviesContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>
<div class="movie-page">
    <h1>Index</h1>

    <SectionContent SectionName="page-actions">
        <a href="movies/create">Create New</a>
    </SectionContent>

    <QuickGrid Class="table" Items="context.Movie">
        <PropertyColumn Property="movie => movie.Title" />
        <PropertyColumn Property="movie => movie.ReleaseDate" />
        <PropertyColumn Property="movie => movie.Genre" />

        <TemplateColumn Context="movie">
            <a href="@($"movies/details?id={movie.Id}")">Details</a> |
        </TemplateColumn>
    </QuickGrid>
</div>

@code {
    private MoviesContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
