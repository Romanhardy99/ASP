@rendermode InteractiveServer

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MyAcademy</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="nav flex-column">

        <!-- Главная -->
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                Главная
            </NavLink>
        </div>


        <!-- Учебный процесс -->
        <div class="nav-item px-3">
            <button class="nav-link menu-button" @onclick="ToggleEducation">
                <span class="bi bi-book" aria-hidden="true"></span>
                Учебный процесс
                <span class="arrow">@(educationOpen ? "▼" : "▶")</span>
            </button>
        </div>

        @if (educationOpen)
        {
            <div class="submenu">

                <NavLink class="nav-link" href="students">
                    Студенты
                </NavLink>

                <NavLink class="nav-link" href="groups">
                    Группы
                </NavLink>

                <NavLink class="nav-link" href="directions">
                    Направления
                </NavLink>

                <NavLink class="nav-link" href="disciplines">
                    Дисциплины
                </NavLink>

                <NavLink class="nav-link" href="teachers">
                    Преподаватели
                </NavLink>

                <NavLink class="nav-link" href="grades">
                    Оценки
                </NavLink>

                <NavLink class="nav-link" href="exams">
                    Экзамены
                </NavLink>

                <NavLink class="nav-link" href="attendance">
                    Посещаемость
                </NavLink>

            </div>
        }


        <!-- Расписание -->
        <div class="nav-item px-3">
            <button class="nav-link menu-button" @onclick="ToggleSchedule">
                <span class="bi bi-calendar" aria-hidden="true"></span>
                Расписание
                <span class="arrow">@(scheduleOpen ? "▼" : "▶")</span>
            </button>
        </div>

        @if (scheduleOpen)
        {
            <div class="submenu">

                <NavLink class="nav-link" href="schedule">
                    Расписание
                </NavLink>

                <NavLink class="nav-link" href="weekends">
                    Выходные дни
                </NavLink>

                <NavLink class="nav-link" href="holidays">
                    Праздники
                </NavLink>

            </div>
        }

    </nav>
</div>


@code
{
    private bool educationOpen = false;
    private bool scheduleOpen = false;

    private void ToggleEducation()
    {
        educationOpen = !educationOpen;
    }

    private void ToggleSchedule()
    {
        scheduleOpen = !scheduleOpen;
    }
}

