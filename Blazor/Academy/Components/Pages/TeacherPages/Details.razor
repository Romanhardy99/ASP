@page "/teachers/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@if (teacher is not null)
{
    <SectionContent SectionName="page-actions">
        <a href="@($"/teachers/edit?teacher_id={teacher.teacher_id}")">Редактировать</a>
        <a href="@($"/teachers/delete?teacher_id={teacher.teacher_id}")">Удалить</a>
    </SectionContent>
}

<div>
    @if (teacher is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <h1>@teacher.FullName</h1>
        <hr />
        <div class="human-container">
            <dl class="row human-text-fields">
                <dt class="col-sm-3">Фамилия</dt>
                <dd class="col-sm-9">@teacher.last_name</dd>
                <dt class="col-sm-3">Имя</dt>
                <dd class="col-sm-9">@teacher.first_name</dd>
                <dt class="col-sm-3">Отчество</dt>
                <dd class="col-sm-9">@teacher.middle_name</dd>
                <dt class="col-sm-3">Дата рождения</dt>
                <dd class="col-sm-9">@teacher.birth_date</dd>
                <dt class="col-sm-3">Возраст</dt>
                <dd class="col-sm-9">@teacher.Age</dd>
                <dt class="col-sm-3">Почта</dt>
                <dd class="col-sm-9">@teacher.email</dd>
                <dt class="col-sm-3">Телефон</dt>
                <dd class="col-sm-9">@teacher.phone</dd>
                <dt class="col-sm-3">Работает с</dt>
                <dd class="col-sm-9">@teacher.work_since</dd>
                <dt class="col-sm-3">Ставка</dt>
                <dd class="col-sm-9">@teacher.rate</dd>
            </dl>
            <Photo Human="teacher" />
        </div>

        <div class="info-section">
            <button type="button" class="info-toggle" @onclick="ToggleDisciplines">
                <span class="bi bi-journal-bookmark"></span>
                Дисциплины
                <span class="badge-count">@teacher.TDR.Count</span>
                <span class="bi @(disciplinesOpen ? "bi-chevron-up" : "bi-chevron-down") info-toggle-arrow"></span>
            </button>
            <div class="info-panel @(disciplinesOpen ? "open" : "")">
                <div class="discipline-tags">
                    @foreach (TeachersDisciplinesRelation tdr in teacher.TDR)
                    {
                        <span class="discipline-tag">@tdr.Discipline.discipline_name</span>
                    }
                </div>
            </div>
        </div>

        <div>
            <a href="@($"/teachers")" class="btn btn-secondary">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Teacher? teacher;
    private bool disciplinesOpen;

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        teacher = await context.Teachers
                                .Include(t => t.TDR)
                                .ThenInclude(tdr => tdr.Discipline)
                                .FirstOrDefaultAsync(m => m.teacher_id == teacher_id);

        if (teacher is null)
        {
            NavigationManager.NotFound();
        }
    }

    private void ToggleDisciplines() => disciplinesOpen = !disciplinesOpen;
}