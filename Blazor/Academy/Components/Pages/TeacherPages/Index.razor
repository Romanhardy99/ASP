@page "/teachers"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Index</PageTitle>

<SectionContent SectionName="page-actions">
    <a href="teachers/create">Добавить</a>
</SectionContent>

<h1>Преподаватели</h1>

<QuickGrid Class="academy-table" Items="context.Teachers">
    <TemplateColumn Title="ФИО" Context="teacher" Sortable="true" SortBy="GridSort<Teacher>.ByAscending(t => t.last_name).ThenAscending(t => t.first_name)">
        <a href="@($"teachers/details?teacher_id={teacher.teacher_id}")">@teacher.FullName</a>
    </TemplateColumn>
    <PropertyColumn Property="teacher => teacher.birth_date" Title="Дата рождения" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.Age" Title="Возраст" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.work_since" Title="Работает с" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.rate" Title="Ставка" Sortable="true" />
    <PropertyColumn Property="teacher => teacher.email" Title="Email" />
    <PropertyColumn Property="teacher => teacher.phone" Title="Телефон" />

    <TemplateColumn Title="Действия" Context="teacher">
        <div class="table-actions">
            <a href="@($"teachers/edit?teacher_id={teacher.teacher_id}")">Редактировать</a>
            <a href="@($"teachers/delete?teacher_id={teacher.teacher_id}")" class="text-danger">Удалить</a>
        </div>
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}