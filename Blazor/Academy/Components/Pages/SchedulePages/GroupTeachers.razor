@page "/schedules/group"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Преподаватели группы</PageTitle>

@if (group is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <h1>@group.group_name</h1>
    <p class="page-subtitle">Направление: <strong>@group.Direction.direction_name</strong></p>
    <hr />

    <h3>Преподаватели, ведущие дисциплины направления</h3>

    @if (teachers.Count == 0)
    {
        <p><em>Нет преподавателей, ведущих дисциплины этого направления</em></p>
    }
    else
    {
        <table class="academy-table">
            <thead>
                <tr>
                    <th>Преподаватель</th>
                    <th>Работает с</th>
                    <th>Ставка</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var teacher in teachers)
                {
                    <tr>
                        <td>
                            <a href="@($"/teachers/details?teacher_id={teacher.teacher_id}")">@teacher.FullName</a>
                        </td>
                        <td>@teacher.work_since</td>
                        <td>@teacher.rate</td>
                        <td>
                            <div class="table-actions">
                                <a href="@($"schedules/assign?group_id={group.group_id}&teacher_id={teacher.teacher_id}")">
                                    Назначить расписание
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div class="page-footer-actions">
        <a href="/schedules" class="btn btn-secondary">Назад к списку групп</a>
    </div>
}

@code {
    private AcademyContext context = default!;

    [SupplyParameterFromQuery]
    private int group_id { get; set; }

    private Group? group;
    private List<Teacher> teachers = new();

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();

        group = await context.Groups
            .Include(g => g.Direction)
            .FirstOrDefaultAsync(g => g.group_id == group_id);

        if (group is null)
        {
            NavigationManager.NotFound();
            return;
        }

        var disciplineIds = await context.DisciplinesDirectionsRelations
            .Where(ddr => ddr.direction == group.direction)
            .Select(ddr => ddr.discipline)
            .ToListAsync();

        teachers = await context.Teachers
            .Where(t => t.TDR.Any(tdr => disciplineIds.Contains(tdr.discipline)))
            .ToListAsync();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}