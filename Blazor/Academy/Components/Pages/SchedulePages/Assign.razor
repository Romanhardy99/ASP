@page "/schedules/assign"
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.Data.SqlClient
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Назначение расписания</PageTitle>

@if (group is null || teacher is null)
{
    <p><em>Загрузка...</em></p>
}
else
{
    <h1>Расписание: @group.group_name — @teacher.FullName</h1>
    <hr />

    <h3>Уже назначенные занятия</h3>

    @if (existingLessons.Count == 0)
    {
        <p><em>Пока нет записей</em></p>
    }
    else
    {
        <table class="academy-table">
            <thead>
                <tr>
                    <th>Дисциплина</th>
                    <th>Дата</th>
                    <th>Время</th>
                    <th>Проведено</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lesson in existingLessons)
                {
                    <tr>
                        <td>
                            <a href="@($"/schedules/lesson?lesson_id={lesson.lesson_id}")">@lesson.Discipline?.discipline_name</a>
                        </td>
                        <td>@lesson.date?.ToString("dd.MM.yyyy")</td>
                        <td>@lesson.time?.ToString(@"hh\:mm")</td>
                        <td>@(lesson.spent ? "Да" : "Нет")</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <hr />

    <div class="row">
        <div class="col-md-4">
            <h3>Добавить одно занятие</h3>
            <EditForm Model="newLesson" OnValidSubmit="SaveLesson">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger" role="alert" />

                <div class="mb-3">
                    <label for="discipline" class="form-label">Дисциплина:</label>
                    <InputSelect id="discipline" @bind-Value="selectedDisciplineId" class="form-control">
                        <option value="0">-- Выберите дисциплину --</option>
                        @foreach (var d in disciplines)
                        {
                            <option value="@d.discipline_id">@d.discipline_name</option>
                        }
                    </InputSelect>
                </div>

                <div class="mb-3">
                    <label for="date" class="form-label">Дата:</label>
                    <InputDate id="date" @bind-Value="selectedDate" class="form-control" />
                </div>

                <div class="mb-3">
                    <label for="time" class="form-label">Время:</label>
                    <InputDate id="time" Type="InputDateType.Time" @bind-Value="selectedTime" class="form-control" />
                </div>

                <div class="mb-3 form-check">
                    <InputCheckbox id="spent" @bind-Value="newLesson.spent" class="form-check-input" />
                    <label for="spent" class="form-check-label">Занятие проведено</label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
            </EditForm>
        </div>

        <div class="col-md-4 offset-md-1">
            <h3>Сгенерировать на весь курс</h3>
            <p><em>Пары создаются хранимой процедурой sp_InsertSchedule по дням занятий группы, по две пары в день.</em></p>

            <div class="mb-3">
                <label for="genDiscipline" class="form-label">Дисциплина:</label>
                <select id="genDiscipline" class="form-control" @bind="genDisciplineId">
                    <option value="0">-- Выберите дисциплину --</option>
                    @foreach (var d in disciplines)
                    {
                        <option value="@d.discipline_id">@d.discipline_name (@d.number_of_lessons зан.)</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label for="genDate" class="form-label">Дата начала:</label>
                <input id="genDate" type="date" class="form-control" @bind="genDate" />
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary"
                        disabled="@(generating || !hasLearningDays)"
                        @onclick="GenerateSchedule">
                    @(generating ? "Генерация..." : "Сгенерировать")
                </button>
            </div>

            @if (!hasLearningDays)
            {
                <p class="text-danger mt-2">У группы не заданы дни занятий: сначала укажите их в настройках группы.</p>
            }
            @if (genMessage is not null)
            {
                <p class="text-danger mt-2">@genMessage</p>
            }
        </div>
    </div>

    <div class="page-footer-actions">
        <a href="@($"schedules/group?group_id={group_id}")" class="btn btn-secondary">Назад к списку преподавателей</a>
    </div>
}

@code {
    private AcademyContext context = default!;

    [SupplyParameterFromQuery]
    private int group_id { get; set; }

    [SupplyParameterFromQuery]
    private int teacher_id { get; set; }

    private Group? group;
    private Teacher? teacher;
    private List<Discipline> disciplines = new();
    private List<Schedule> existingLessons = new();

    // Одно занятие
    private Schedule newLesson = new();
    private int selectedDisciplineId;
    private DateOnly? selectedDate;
    private TimeOnly? selectedTime;

    // Генерация через хранимую процедуру
    private int genDisciplineId;
    private DateOnly genDate = DateOnly.FromDateTime(DateTime.Today);
    private bool generating;
    private bool hasLearningDays;
    private string? genMessage;

    protected override async Task OnInitializedAsync()
    {
        context = DbFactory.CreateDbContext();

        group = await context.Groups.FirstOrDefaultAsync(g => g.group_id == group_id);
        teacher = await context.Teachers.FirstOrDefaultAsync(t => t.teacher_id == teacher_id);

        if (group is null || teacher is null)
        {
            NavigationManager.NotFound();
            return;
        }

        hasLearningDays = Convert.ToInt32(group.learning_days) != 0;

        // Показываем только те дисциплины, которые этот преподаватель реально ведёт
        var teacherDisciplineIds = await context.TeachersDisciplinesRelations
            .Where(tdr => tdr.teacher == teacher_id)
            .Select(tdr => tdr.discipline)
            .ToListAsync();

        disciplines = await context.Disciplines
            .Where(d => teacherDisciplineIds.Contains(d.discipline_id))
            .ToListAsync();

        existingLessons = await context.Schedule
            .Include(s => s.Discipline)
            .Where(s => s.group == group_id && s.teacher == teacher_id)
            .OrderBy(s => s.date).ThenBy(s => s.time)
            .ToListAsync();
    }

    private async Task SaveLesson()
    {
        if (selectedDisciplineId == 0 || selectedDate is null || selectedTime is null)
        {
            return;
        }

        newLesson.group = group_id;
        newLesson.teacher = teacher_id;
        newLesson.discipline = selectedDisciplineId;
        newLesson.date = selectedDate;
        newLesson.time = selectedTime.Value.ToTimeSpan();

        context.Schedule.Add(newLesson);
        await context.SaveChangesAsync();

        NavigationManager.NavigateTo($"/schedules/assign?group_id={group_id}&teacher_id={teacher_id}", forceLoad: true);
    }

    private async Task GenerateSchedule()
    {
        genMessage = null;

        var discipline = disciplines.FirstOrDefault(d => d.discipline_id == genDisciplineId);
        if (discipline is null)
        {
            genMessage = "Выберите дисциплину.";
            return;
        }

        // Процедура не проверяет повторный запуск: защищаемся сами
        bool alreadyExists = await context.Schedule
            .AnyAsync(s => s.group == group_id && s.discipline == genDisciplineId);
        if (alreadyExists)
        {
            genMessage = "По этой дисциплине у группы уже есть занятия в расписании.";
            return;
        }

        generating = true;
        try
        {
            await context.Database.ExecuteSqlInterpolatedAsync(
                $"EXEC dbo.sp_InsertSchedule {group!.group_name}, {discipline.discipline_name}, {teacher!.last_name}, {genDate.ToDateTime(TimeOnly.MinValue)}");
        }
        catch (SqlException ex)
        {
            genMessage = $"Ошибка при генерации: {ex.Message}";
            generating = false;
            return;
        }

        NavigationManager.NavigateTo($"/schedules/assign?group_id={group_id}&teacher_id={teacher_id}", forceLoad: true);
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}