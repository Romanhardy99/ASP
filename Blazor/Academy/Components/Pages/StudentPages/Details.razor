@page "/students/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models

@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@* <h1>Details</h1> *@

<div>
    @* <h2>Student</h2> *@
    @* <hr /> *@
    @if (student is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <div class="controls"> 
            <h1>@student.FullName</h1>
            <a href="@($"/students/edit?stud_id={student.stud_id}")" class="btn btn-primary">Редактировать</a>
        </div>
        <hr />
        <div class="human-container">
            <dl class="row human-text-fields">
                <dt class="col-sm-3">Фамилия</dt>     <dd class="col-sm-9">@student.last_name</dd>
                <dt class="col-sm-3">Имя</dt>    <dd class="col-sm-9">@student.first_name</dd>
                <dt class="col-sm-3">Отчество</dt>   <dd class="col-sm-9">@student.middle_name</dd>
                <dt class="col-sm-3">Группа</dt>         <dd class="col-sm-9">@student.Group.group_name</dd>
                <dt class="col-sm-3">Направление</dt>     <dd class="col-sm-9">@student.Group.Direction.direction_name</dd>
                <dt class="col-sm-3">Дата рождения</dt>    <dd class="col-sm-9">@student.birth_date</dd>
                <dt class="col-sm-3">Почта</dt>         <dd class="col-sm-9">@student.email</dd>
                <dt class="col-sm-3">Телефон</dt>         <dd class="col-sm-9">@student.phone</dd>
            </dl>
            <Photo Human="student" />
        </div>
        <div>
         @*    <a href="@($"/students/edit?stud_id={student.stud_id}")">Edit</a> | *@
            <a href="@($"/students")" class="btn btn-secondary">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Student? student;

    [SupplyParameterFromQuery]
    private int stud_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        student = await context.Students
        .Include(s => s.Group)
        .ThenInclude(g => g.Direction)
        .FirstOrDefaultAsync(m => m.stud_id == stud_id);

        if (student is null)
        {
            NavigationManager.NotFound();
        }
    }
}
