@page "/students"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Student</PageTitle>

<SectionContent SectionName="page-actions">
    <a href="students/create">Добавить</a>
</SectionContent>


<h1>Студенты</h1>
<div class="student-filters mb-3">
    <div style="max-width: 300px;">
        <form action="/Students" data-enhance>
            <label for="search" class="form-label">Поиск по имени/фамилии:</label>
            <input type="text" id="search" class="form-control"
                   placeholder="Введите имя или фамилию..."
                   @bind="searchText" @bind:event="oninput" />
                  
        </form>
    </div>

    <div style="max-width: 200px;">
        <label for="pageSize" class="form-label">Студентов на странице:</label>
        <input type="number" id="pageSize" class="form-control"
               value="@pagination.ItemsPerPage"
               min="1" max="100"
               @onchange="OnPageSizeChanged" />
    </div>
</div>

@* <QuickGrid Class="table" Items="context.Students.Include(s => s.Group).ThenInclude(g => g.Direction)"> *@
<QuickGrid Class="academy-table" Items="FilteredStudents" Pagination="pagination">
    <TemplateColumn Context="student"
                    Title="Student"
                    Sortable="true"
                    SortBy="sortBy">
        <a href="@($"students/details?stud_id={student.stud_id}")">@student.FullName</a>
    </TemplateColumn>
    <PropertyColumn Property="student => student.birth_date" Sortable="true" />
    <TemplateColumn Context="student"
                    Title="Age"
                    Sortable="true"
                    SortBy="GridSort<Student>.ByDescending(s => s.birth_date)">
        @student.Age
    </TemplateColumn>
    <PropertyColumn Property="student => student.Group.group_name" Sortable="true" />
    <PropertyColumn Property="student => student.Group.Direction.direction_name" />
</QuickGrid>

<Paginator State="pagination" />

@code {
    private AcademyContext context = default!;

    private PaginationState pagination = new PaginationState { ItemsPerPage = 40 };

    [SupplyParameterFromQuery]
    string? searchText { get; set; }

    GridSort<Student> sortBy = GridSort<Student>.ByAscending(s => s.last_name).
                                                 ThenAscending(s => s.first_name);

    IQueryable<Student> FilteredStudents =>
            context.Students
            .Include(s => s.Group)
            .ThenInclude(s => s.Direction)
            .AsEnumerable()
            .Where(s => s.FullName.Contains(searchText ?? string.Empty))
            .AsQueryable();


    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();

    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int value) && value > 0)
        {
            pagination.ItemsPerPage = value;
            await pagination.SetCurrentPageIndexAsync(0);
        }
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}