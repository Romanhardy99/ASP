@page "/students/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление студента</PageTitle>

<div>
    @if (student is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <h1>Удаление: @student.FullName</h1>
        <p class="text-danger">Вы уверены, что хотите удалить этого студента? Это действие нельзя отменить.</p>
        <hr />
        <div class="human-container">
            <dl class="row human-text-fields">
                <dt class="col-sm-3">Фамилия</dt>
                <dd class="col-sm-9">@student.last_name</dd>
                <dt class="col-sm-3">Имя</dt>
                <dd class="col-sm-9">@student.first_name</dd>
                <dt class="col-sm-3">Отчество</dt>
                <dd class="col-sm-9">@student.middle_name</dd>
                <dt class="col-sm-3">Группа</dt>
                <dd class="col-sm-9">@student.Group?.group_name</dd>
                <dt class="col-sm-3">Дата рождения</dt>
                <dd class="col-sm-9">@student.birth_date</dd>
                <dt class="col-sm-3">Почта</dt>
                <dd class="col-sm-9">@student.email</dd>
                <dt class="col-sm-3">Телефон</dt>
                <dd class="col-sm-9">@student.phone</dd>
            </dl>
            <Photo Human="student" />
        </div>

        <EditForm method="post" Model="student" OnValidSubmit="DeleteStudent" FormName="delete" Enhance>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Удалить</button>
                <a href="@($"/students/details?stud_id={student.stud_id}")" class="btn btn-secondary">Отмена</a>
            </div>
        </EditForm>
    }
</div>

@code {
    private Student? student;

    [SupplyParameterFromQuery]
    private int stud_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        student = await context.Students
                               .Include(s => s.Group)
                               .FirstOrDefaultAsync(m => m.stud_id == stud_id);

        if (student is null)
        {
            NavigationManager.NotFound();
        }
    }

    private async Task DeleteStudent()
    {
        using var context = DbFactory.CreateDbContext();

        // Сначала удаляем отметки посещаемости студента,
        // иначе внешний ключ Attendance → Students не даст удалить запись
        context.Attendances.RemoveRange(
            context.Attendances.Where(a => a.student == stud_id));

        var toDelete = await context.Students.FindAsync(stud_id);
        if (toDelete is not null)
        {
            context.Students.Remove(toDelete);
        }

        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/students");
    }
}