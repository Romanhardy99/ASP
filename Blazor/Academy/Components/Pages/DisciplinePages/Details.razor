@page "/disciplines/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@if (discipline is not null)
{
    <SectionContent SectionName="page-actions">
        <a href="@($"/disciplines/edit?discipline_id={discipline.discipline_id}")">Редактировать</a>
        <a href="@($"/disciplines/delete?discipline_id={discipline.discipline_id}")">Удалить</a>
    </SectionContent>
}

<div>
    @if (discipline is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <h1>@discipline.discipline_name</h1>
        <hr />
        <dl class="row human-text-fields">
            <dt class="col-sm-3">Количество занятий</dt>
            <dd class="col-sm-9">@discipline.number_of_lessons</dd>
        </dl>

        <div class="info-section">
            <button type="button" class="info-toggle" @onclick="ToggleTeachers">
                <span class="bi bi-person-badge"></span>
                Преподаватели
                <span class="badge-count">@discipline.TDR.Count</span>
                <span class="bi @(teachersOpen ? "bi-chevron-up" : "bi-chevron-down") info-toggle-arrow"></span>
            </button>
            <div class="info-panel @(teachersOpen ? "open" : "")">
                @if (discipline.TDR.Any())
                {
                    <div class="discipline-tags">
                        @foreach (TeachersDisciplinesRelation tdr in discipline.TDR)
                        {
                            <a class="discipline-tag" href="@($"/teachers/details?teacher_id={tdr.Teacher.teacher_id}")">
                                @tdr.Teacher.FullName
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p><em>Преподаватели не назначены</em></p>
                }
            </div>
        </div>

        <div>
            <a href="@($"/disciplines")" class="btn btn-secondary">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Discipline? discipline;
    private bool teachersOpen;

    [SupplyParameterFromQuery]
    private int discipline_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();

        discipline = await context.Disciplines
                                    .Include(d => d.TDR)
                                    .ThenInclude(tdr => tdr.Teacher)
                                    .FirstOrDefaultAsync(m => m.discipline_id == discipline_id);

        if (discipline is null)
        {
            NavigationManager.NotFound();
        }
    }

    private void ToggleTeachers() => teachersOpen = !teachersOpen;
}