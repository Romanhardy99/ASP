@page "/directions/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Создание направления</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Direction" OnValidSubmit="AddDirection" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <label for="direction_name" class="form-label">Название направления:</label>
                <InputText id="direction_name" @bind-Value="Direction.direction_name" class="form-control" />
                <ValidationMessage For="() => Direction.direction_name" class="text-danger" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Добавить</button>
                <a href="/directions" class="btn btn-secondary">Назад к списку</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Direction Direction { get; set; } = default!;

    protected override void OnInitialized() => Direction ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddDirection()
    {
        using var context = DbFactory.CreateDbContext();
        context.Directions.Add(Direction);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/directions");
    }
}