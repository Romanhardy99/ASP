@page "/directions/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление направления</PageTitle>

<div>
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <h1>Удаление: @direction.direction_name</h1>

        @if (groupCount > 0)
        {
            <p class="text-danger">
                Направление нельзя удалить: к нему относится групп: @groupCount. Сначала удалите их или перенесите на другое направление.
            </p>
        }
        else
        {
            <p class="text-danger">
                Вы уверены, что хотите удалить это направление?
                @if (disciplineCount > 0)
                {
                    <span>Будут удалены его связи с дисциплинами (@disciplineCount), сами дисциплины останутся.</span>
                }
                Это действие нельзя отменить.
            </p>
        }
        <hr />

        <dl class="row human-text-fields">
            <dt class="col-sm-3">Групп</dt>
            <dd class="col-sm-9">@groupCount</dd>
            <dt class="col-sm-3">Дисциплин</dt>
            <dd class="col-sm-9">@disciplineCount</dd>
        </dl>

        <EditForm method="post" Model="direction" OnValidSubmit="DeleteDirection" FormName="delete" Enhance>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger" disabled="@(groupCount > 0)">Удалить</button>
                <a href="@($"/directions/details?direction_id={direction.direction_id}")" class="btn btn-secondary">Отмена</a>
            </div>
        </EditForm>
    }
</div>

@code {
    private Direction? direction;
    private int groupCount;
    private int disciplineCount;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NotFound();
            return;
        }

        groupCount = await context.Groups.CountAsync(g => g.direction == direction_id);
        disciplineCount = await context.DisciplinesDirectionsRelations.CountAsync(ddr => ddr.direction == direction_id);
    }

    private async Task DeleteDirection()
    {
        using var context = DbFactory.CreateDbContext();

        // Повторная проверка на сервере
        if (await context.Groups.AnyAsync(g => g.direction == direction_id))
        {
            return;
        }

        // 1. Связи направления с дисциплинами (сами дисциплины остаются)
        context.DisciplinesDirectionsRelations.RemoveRange(
            context.DisciplinesDirectionsRelations.Where(ddr => ddr.direction == direction_id));

        // 2. Само направление
        var toDelete = await context.Directions.FindAsync(direction_id);
        if (toDelete is not null)
        {
            context.Directions.Remove(toDelete);
        }

        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/directions");
    }
}