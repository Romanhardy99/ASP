@page "/directions/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

@if (direction is not null)
{
    <SectionContent SectionName="page-actions">
        <a href="@($"/directions/edit?direction_id={direction.direction_id}")">Редактировать</a>
        <a href="@($"/directions/delete?direction_id={direction.direction_id}")">Удалить</a>
    </SectionContent>
}

<div>
    <h2>Направление</h2>
    <hr />
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-3">Название направления</dt>
            <dd class="col-sm-9">@direction.direction_name</dd>
        </dl>
        <div>
            <a href="@($"/directions")" class="btn btn-secondary">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NotFound();
        }
    }
}