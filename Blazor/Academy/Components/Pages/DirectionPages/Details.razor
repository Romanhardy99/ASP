@page "/directions/details"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Details</PageTitle>

<h1>Подробнее</h1>

<div>
    <h2>Направление</h2>
    <hr />
    @if (direction is null)
    {
        <p><em>Loading...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">direction_name</dt>
            <dd class="col-sm-10">@direction.direction_name</dd>
        </dl>
        <div>
            <a href="@($"/directions/edit?direction_id={direction.direction_id}")" class="btn btn-primary">Редактировать</a> |
            <a href="@($"/directions/delete?direction_id={direction.direction_id}")" class="btn btn-danger">Удалить</a> |
            <a href="@($"/directions")" class="btn btn-secondary">Назад к списку</a>
        </div>
    }
</div>

@code {
    private Direction? direction;

    [SupplyParameterFromQuery]
    private int direction_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        direction = await context.Directions.FirstOrDefaultAsync(m => m.direction_id == direction_id);

        if (direction is null)
        {
            NavigationManager.NotFound();
        }
    }
}
