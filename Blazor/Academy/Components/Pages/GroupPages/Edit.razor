@page "/groups/edit"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Редактирование группы</h1>
<hr />
@if (Group is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Group" OnValidSubmit="UpdateGroup" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert" />
                <input type="hidden" name="Group.group_id" value="@Group.group_id" />
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="group_name" class="form-label">Название группы:</label>
                    <InputText id="group_name" @bind-Value="Group.group_name" class="form-control" aria-required="true" />
                    <ValidationMessage For="() => Group.group_name" class="text-danger" />
                </div>
                <div class="mb-3">
                    <span class="text-danger">*</span>
                    <label for="direction" class="form-label">Направление:</label>
                    <InputSelect @bind-Value="Group.direction" class="form-control">
                        @using (AcademyContext context = DbFactory.CreateDbContext())
                        {
                            @foreach (Direction direction in context.Directions)
                            {
                                <option value="@direction.direction_id">@direction.direction_name</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Group.direction" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="start_date" class="form-label">Дата начала:</label>
                    <InputDate id="start_date" @bind-Value="Group.start_date" class="form-control" />
                    <ValidationMessage For="() => Group.start_date" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="start_time" class="form-label">Время начала:</label>
                    <InputDate Type="InputDateType.Time" id="start_time" @bind-Value="Group.start_time" class="form-control" />
                    <ValidationMessage For="() => Group.start_time" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="learning_days" class="form-label">Дни занятий:</label>
                    <InputNumber id="learning_days" @bind-Value="Group.learning_days" class="form-control" />
                    <ValidationMessage For="() => Group.learning_days" class="text-danger" />
                </div>
                <LearningDays Group="@Group" />

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a href="/groups" class="btn btn-secondary">Назад к списку</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [SupplyParameterFromQuery]
    private int group_id { get; set; }

    [SupplyParameterFromForm]
    private Group? Group { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Group ??= await context.Groups.FirstOrDefaultAsync(m => m.group_id == group_id);

        if (Group is null)
        {
            NavigationManager.NotFound();
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateGroup()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Group!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!GroupExists(Group!.group_id))
            {
                NavigationManager.NotFound();
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo($"/groups/details?group_id={group_id}");
    }

    private bool GroupExists(int group_id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Groups.Any(e => e.group_id == group_id);
    }
}