@page "/groups"
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@implements IAsyncDisposable
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Groups</PageTitle>

<div class="controls">
    <h1>Группы</h1>

    <p>
        <a href="groups/create" class="btn btn-primary">Добавить</a>
    </p>
</div>

<QuickGrid Class="academy-table" Items="context.Groups">
    <PropertyColumn Property="group => group.group_name" Title="Название группы"/>
    <PropertyColumn Property="group => group.direction" />
    <PropertyColumn Property="group => group.start_date" />
    <PropertyColumn Property="group => group.start_time" />
    <PropertyColumn Property="group => group.learning_days" />
    <PropertyColumn Property="group => new Week((int)group.learning_days)" />
    @* <PropertyColumn Property="group => group.Direction" /> *@

    <TemplateColumn Context="group">
        <a href="@($"groups/details?group_id={group.group_id}")" class="btn btn-info">Подробнее</a> |
    </TemplateColumn>
</QuickGrid>

@code {
    private AcademyContext context = default!;

    protected override void OnInitialized()
    {
        context = DbFactory.CreateDbContext();
    }

    public async ValueTask DisposeAsync() => await context.DisposeAsync();
}
