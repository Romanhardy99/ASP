@page "/groups/create"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Create</PageTitle>

<h1>Создание группы</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <EditForm method="post" Model="Group" OnValidSubmit="AddGroup" FormName="create" Enhance>
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="group_name" class="form-label">Название группы:</label>
                <InputText id="group_name" @bind-Value="Group.group_name" class="form-control" aria-required="true" />
                <ValidationMessage For="() => Group.group_name" class="text-danger" />
            </div>
            <div class="mb-3">
                <span class="text-danger">*</span>
                <label for="direction" class="form-label">Направление:</label>
                <InputSelect @bind-Value="Group.direction" class="form-control">
                    <option selected disabled>--- Выберите направление обучения ---</option>
                    @using (AcademyContext context = DbFactory.CreateDbContext())
                    {
                        @foreach (Direction direction in context.Directions)
                        {
                            <option value="@direction.direction_id">@direction.direction_name</option>
                        }
                    }
                </InputSelect>
                <ValidationMessage For="() => Group.direction" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="start_date" class="form-label">Дата начала:</label>
                <InputDate id="start_date" @bind-Value="Group.start_date" class="form-control" />
                <ValidationMessage For="() => Group.start_date" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="start_time" class="form-label">Время начала:</label>
                <InputDate Type="InputDateType.Time" id="start_time" @bind-Value="Group.start_time" class="form-control" />
                <ValidationMessage For="() => Group.start_time" class="text-danger" />
            </div>
            <div class="mb-3">
                <label for="learning_days" class="form-label">Дни занятий:</label>
                <InputNumber id="learning_days" @bind-Value="Group.learning_days" class="form-control" />
                <ValidationMessage For="() => Group.learning_days" class="text-danger" />
            </div>
            <LearningDays Group="Group" />

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Добавить</button>
                <a href="/groups" class="btn btn-secondary">Назад к списку</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private Group Group { get; set; } = default!;

    protected override void OnInitialized() => Group ??= new();

    // To protect from overposting attacks, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task AddGroup()
    {
        using var context = DbFactory.CreateDbContext();
        context.Groups.Add(Group);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/groups");
    }
}