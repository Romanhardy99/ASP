@page "/groups/delete"
@using Microsoft.EntityFrameworkCore
@using Academy.Models
@inject IDbContextFactory<AcademyContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Удаление группы</PageTitle>

<div>
    @if (group is null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <h1>Удаление: @group.group_name</h1>

        @if (studentCount > 0)
        {
            <p class="text-danger">
                Группу нельзя удалить: в ней @studentCount студ. Сначала переведите их в другую группу или удалите.
            </p>
        }
        else
        {
            <p class="text-danger">
                Вы уверены, что хотите удалить эту группу?
                @if (lessonCount > 0)
                {
                    <span>Вместе с ней будет удалено расписание (@lessonCount занят.) и отметки посещаемости.</span>
                }
                Это действие нельзя отменить.
            </p>
        }
        <hr />

        <dl class="row human-text-fields">
            <dt class="col-sm-3">Направление</dt>
            <dd class="col-sm-9">@group.Direction.direction_name</dd>
            <dt class="col-sm-3">Дата начала</dt>
            <dd class="col-sm-9">@($"{group.start_date:dd.MM.yyyy}")</dd>
            <dt class="col-sm-3">Время начала</dt>
            <dd class="col-sm-9">@($"{group.start_time:HH:mm}")</dd>
            <dt class="col-sm-3">Дни занятий</dt>
            <dd class="col-sm-9">@(new Week((int)group.learning_days))</dd>
            <dt class="col-sm-3">Студентов</dt>
            <dd class="col-sm-9">@studentCount</dd>
            <dt class="col-sm-3">Занятий в расписании</dt>
            <dd class="col-sm-9">@lessonCount</dd>
        </dl>

        <EditForm method="post" Model="group" OnValidSubmit="DeleteGroup" FormName="delete" Enhance>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger" disabled="@(studentCount > 0)">Удалить</button>
                <a href="@($"/groups/details?group_id={group.group_id}")" class="btn btn-secondary">Отмена</a>
            </div>
        </EditForm>
    }
</div>

@code {
    private Group? group;
    private int studentCount;
    private int lessonCount;

    [SupplyParameterFromQuery]
    private int group_id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        group = await context.Groups
                              .Include(g => g.Direction)
                              .FirstOrDefaultAsync(m => m.group_id == group_id);

        if (group is null)
        {
            NavigationManager.NotFound();
            return;
        }

        studentCount = await context.Students.CountAsync(s => s.group == group_id);
        lessonCount = await context.Schedule.CountAsync(s => s.group == group_id);
    }

    private async Task DeleteGroup()
    {
        using var context = DbFactory.CreateDbContext();

        // Повторная проверка на сервере: кнопку можно обойти
        if (await context.Students.AnyAsync(s => s.group == group_id))
        {
            return;
        }

        // 1. Отметки посещаемости по парам этой группы
        var lessonIds = context.Schedule
                               .Where(s => s.group == group_id)
                               .Select(s => s.lesson_id);

        context.Attendances.RemoveRange(
            context.Attendances.Where(a => lessonIds.Contains(a.lesson)));

        // 2. Расписание группы
        context.Schedule.RemoveRange(
            context.Schedule.Where(s => s.group == group_id));

        // 3. Сама группа
        var toDelete = await context.Groups.FindAsync(group_id);
        if (toDelete is not null)
        {
            context.Groups.Remove(toDelete);
        }

        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/groups");
    }
}